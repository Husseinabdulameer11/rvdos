var a[10]
for i = 0 to 9
  a[i] = i * i
end
print a[3], " ", a[9], " ", len(a)
func sum(arr)
  var s = 0
  for i = 0 to len(arr) - 1
    s += arr[i]
  end
  return s
end
print sum(a)
func make()
  var tmp[5]
  tmp[2] = 7
  return tmp[2] + len(tmp)
end
print make(), " ", make()
a[1] += 41
a[1] -= 1
print a[1]
var sieve[100]
var count = 0
for i = 2 to 99
  if sieve[i] == 0
    count += 1
    for j = i * i to 99 step i
      sieve[j] = 1
    end
  end
end
print count, " primes below 100"
print a[10]
print "not reached"
