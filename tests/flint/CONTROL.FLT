for i = 1 to 3
  if i == 1
    print "one";
  elif i == 2
    print " two";
  else
    print " three"
  end
end
var n = 0
while true
  n += 1
  if n % 2 == 0
    continue
  end
  if n > 7
    break
  end
  print n;
end
print
for i = 10 to 1 step -3
  print i, " ";
end
print
for i = 1 to 5
  for j = 1 to 5
    if j > i
      break
    end
    print j;
  end
  print " ";
end
print
for k = 1 to 0
  print "never"
end
var total = 0
for i = 1 to 10
  if i == 5
    continue
  end
  total += i
end
print total
